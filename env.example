# ==========================================
# POLYMARKET COPYTRADING BOT - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials!

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Get these from your Supabase project dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy URL and anon/public key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# ==========================================
# POLYMARKET CONFIGURATION
# ==========================================
# PK: Your Ethereum Private Key (NEVER share this!)
# Get from https://reveal.magic.link/polymarket or your Web3 wallet
PK=your-private-key-here

# POLY_FUNDER: Your Polymarket Proxy Address
# This is the address shown below your profile picture on Polymarket
POLY_FUNDER=your-polymarket-proxy-address-here

# CLOB_API_URL: Polymarket CLOB API endpoint
CLOB_API_URL=https://clob.polymarket.com

# POLY_CHAIN_ID: Polygon chain ID (137 for mainnet, 80002 for Amoy testnet)
POLY_CHAIN_ID=137

# ==========================================
# TRADER TO COPY
# ==========================================
# TRADER_WALLET: The wallet address of the trader you want to copy
# Find successful traders on Polymarket leaderboards
TRADER_WALLET=trader-wallet-address-to-copy

# ==========================================
# SAFETY / RUNTIME MODE (REQUIRED)
# ==========================================
# DRY_RUN controls whether the bot places real orders.
#   true  = simulate only (logs the order, does NOT hit the CLOB)
#   false = LIVE TRADING, real orders are submitted to Polymarket
# No default — you must choose explicitly. Start with true to verify
# your wiring (Supabase realtime, target wallet filter, sizing), then
# flip to false when you're ready to trade real funds.
DRY_RUN=true

# ==========================================
# OPTIONAL: DATABASE TABLE NAMES
# ==========================================
# Customize these if you want different table names in Supabase
# TABLE_NAME_TRADES=historic_trades
# TABLE_NAME_POSITIONS=polymarket_positions

# ==========================================
# OPTIONAL: SIZING CONFIGURATION
# ==========================================
# BANKROLL: your trading capital in USDC. Used by the risk manager to
# cap total/per-market/per-trader exposure (default: 1000).
# BANKROLL=1000

# STAKE_WHALE_PCT: fraction of the target trader's USDC size to copy.
# Example: 0.001 copies 0.1% — a $10,000 whale trade becomes a $10 bot order.
# Default: 0.005 (0.5%).
# STAKE_WHALE_PCT=0.005

# STAKE_MIN / STAKE_MAX: floor and cap on the scaled per-trade USDC size.
# Defaults: STAKE_MIN=5, STAKE_MAX=20.
#
# IMPORTANT: trades where `target_usdc_size * STAKE_WHALE_PCT < STAKE_MIN`
# are SKIPPED (logged as "Skipping trade: scaled size ... below STAKE_MIN").
# With the defaults above, the target wallet must place a single trade of
# at least $1,000 for anything to be copied (5 / 0.005). With
# STAKE_WHALE_PCT=0.001 the floor becomes $5,000. Lower STAKE_MIN if you
# want to copy smaller trades — but note Polymarket's CLOB has its own
# minimum (~$1) below which orders are rejected.
# STAKE_MIN=5
# STAKE_MAX=20

